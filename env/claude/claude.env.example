# Claude Code credentials (direct Anthropic API or Azure AI Foundry)
#
# For direct Anthropic API:
# ANTHROPIC_API_KEY=sk-ant-...
#
# For Azure AI Foundry (as used in the original VEX-Bench paper):
# CLAUDE_CODE_USE_BEDROCK=0
# CLAUDE_CODE_USE_VERTEX=0
# ANTHROPIC_BASE_URL=https://your-foundry-endpoint.azure.com
# ANTHROPIC_API_KEY=your-foundry-key
