# Vertex AI via localhost proxy
#
# If your org routes Claude Code through a local proxy that handles
# Vertex AI auth/region routing, set the proxy URL here. The Docker
# container uses --network host to reach it.
#
# If your org uses direct Vertex AI (no proxy), set ANTHROPIC_VERTEX_REGION
# to the actual deployment region and provide GCP credentials separately.

ANTHROPIC_BASE_URL=http://host.docker.internal:8787/v1
ANTHROPIC_API_KEY=proxy
CLOUD_ML_REGION=global
CLAUDE_CODE_USE_VERTEX=1
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
